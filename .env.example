LIFI_API_KEY=
MONGODB_URL=
ETHEREUM_RPC_URL=https://eth.drpc.org
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
INTENT_DEADLINE_SECONDS=3600
# Zerion API (free plan: 2000 req/day, 10 req/sec) — used for fast portfolio reads
ZERION_API_KEY=
# Tatum gateway key — sent as x-api-key header for mainnet/base/monad reads
# (Tatum primary, public node fallback). Set the real value in .env only.
TATUM_API_KEY=
# Optional: override the monthly paid-RPC credit cap used by the budget guard
TATUM_MONTHLY_CREDIT_CAP=4000000
